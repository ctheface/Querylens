# ── App database (Supabase project 1: querylens-app) ─────────────────────────
# Use the SHARED POOLER in SESSION MODE (port 5432), not the direct db.<ref> host
# (direct host is IPv6-only on free tier). Find it under Connect > Session pooler.
APP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Demo customer database (Supabase project 2: querylens-demo) ──────────────
# Admin URL is used only by `npm run seed:demo`.
DEMO_ADMIN_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Password the seed script assigns to the read-only role `querylens_ro`.
DEMO_RO_PASSWORD=choose-a-strong-password

# ── Secrets ───────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes), used to encrypt stored data-source passwords (AES-256-GCM).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── LLM (Google Gemini free tier by default) ─────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Older models like gemini-2.5-flash are no longer served to new API keys.
LLM_MODEL=gemini-3.5-flash
# Gemini 3.x reasoning tokens count against the output budget. Keeping the thinking
# budget at 0 makes SQL generation ~5x cheaper with no loss in quality here.
# Set to "auto" to use the model default.
LLM_THINKING_BUDGET=0
LLM_MAX_OUTPUT_TOKENS=4096

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
